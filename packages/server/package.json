{
  "name": "@kitlane/server",
  "version": "0.2.0",
  "description": "Kitlane control service: catalog, names, publishing, shell, SDK routes, document storage",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "kitlane-server": "dist/bin.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node build-client.mjs && tsx watch src/bin.ts",
    "start": "node dist/bin.js",
    "seed": "tsx src/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@hono/node-server": "^1.13.0",
    "hono": "^4.6.0",
    "pg": "^8.13.0",
    "tar-stream": "^3.1.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/tar-stream": "^3.1.3",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
