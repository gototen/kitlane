# Copy to .env (scripts/setup.sh does this and fills in the secrets).
# --- Addresses ---------------------------------------------------------------
# Portal host. Tool origins become app-<id>.sites.<KITLANE_DOMAIN>.
# Local demo: kit.localhost (browsers resolve *.localhost to this machine). Team: kit.example.com
KITLANE_DOMAIN=kit.localhost
KITLANE_SHORTCUT=kit
HTTP_PORT=80
HTTPS_PORT=443
# Local demo uses Caddyfile.local (internal CA). Team deployments use Caddyfile.team (ACME).
CADDYFILE=Caddyfile.local
ACME_EMAIL=

# --- Secrets (scripts/setup.sh generates these) -------------------------------
POSTGRES_PASSWORD=
KITLANE_SECRET=
KITLANE_INGRESS_SECRET=
OAUTH2_PROXY_COOKIE_SECRET=

# --- Identity ------------------------------------------------------------------
# Local demo: the bundled Keycloak realm (users alice/bob/carol/dave, password "password").
OIDC_CLIENT_ID=kitlane-portal
OIDC_CLIENT_SECRET=local-demo-client-secret-change-me
# Team: your provider's issuer, e.g. https://login.example.com/realms/corp or https://accounts.google.com
OIDC_ISSUER_URL=https://auth.kit.localhost/realms/kitlane
OIDC_DISPLAY_NAME=Company sign-in
# Restrict who may sign in (comma separated email domains, or * for any account the IdP accepts).
OIDC_EMAIL_DOMAINS=*
OIDC_SCOPE=openid email profile
# Claim used as the stable opaque user ID (sub is recommended) and the claim carrying team.
OIDC_USER_ID_CLAIM=sub
OIDC_EMAIL_CLAIM=email
OIDC_TEAM_CLAIM=team
OIDC_ALLOW_UNVERIFIED_EMAIL=false

# --- Kitlane policy --------------------------------------------------------------
# Initial administrators: comma separated external IDs (sub) or emails. They become admins on first sign-in.
KITLANE_ADMIN_USERS=alice@example.test
KITLANE_INSTALLATION_ID=default
# Expose email through kitlane.me()? (installation policy)
KITLANE_EXPOSE_EMAIL=false
# Where people report a tool: an email address or URL shown in the portal footer.
KITLANE_REPORTING_CONTACT=
# Content-Security-Policy additions for hosted tools (space separated sources), e.g. https://cdn.example.com
KITLANE_HOSTED_SCRIPT_SRC=
KITLANE_HOSTED_CONNECT_SRC=
KITLANE_HOSTED_STYLE_SRC=
KITLANE_HOSTED_FONT_SRC=
KITLANE_HOSTED_IMG_SRC=

# Local Keycloak admin console (https://auth.kit.localhost/admin)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
